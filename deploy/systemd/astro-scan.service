[Unit]
Description=Astro local evidence scan and Luna router
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=astro
Group=astro
WorkingDirectory=/opt/astro
EnvironmentFile=/etc/astro-signal.env
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=ASTRO_STATE_DIR=/var/lib/astro-signal
Environment=ASTRO_FORECAST_PATH=/var/lib/astro-signal/forecast.json
Environment=ASTRO_CODEX_INDEX=/var/lib/astro-signal/codex-index.json
Environment=ASTRO_CODEX_ARCHIVE=/var/lib/astro-signal/codex-archive
Environment=ASTRO_TELEGRAM_SOURCE_PATH=/var/lib/astro-signal/telegram-source.json
Environment=ASTRO_X_SOURCE_PATH=/var/lib/astro-signal/x-source.json
Environment=ASTRO_CODEX_BIN=/usr/bin/codex
Environment=ASTRO_DEEPSEEK_DAILY_CAP=100
Environment=ASTRO_LUNA_LIGHT_DAILY_CAP=8
Environment=ASTRO_LUNA_MEDIUM_DAILY_CAP=5
ExecStart=/usr/bin/npm run astro:vps:scan
TimeoutStartSec=300
StateDirectory=astro-signal
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/astro/.codex /opt/astro/.astro
ProtectKernelTunables=true
ProtectControlGroups=true
ProtectKernelModules=true
RestrictSUIDSGID=true
LockPersonality=true
UMask=0077
