# Added to Sites only after the private VPS signal service is ready.
ASTRO_SIGNAL_URL=https://your-private-vps.example/signal
ASTRO_SIGNAL_TOKEN=replace-with-a-long-random-secret

# VPS service settings. Keep the service on localhost behind HTTPS.
ASTRO_SIGNAL_HOST=127.0.0.1
ASTRO_SIGNAL_PORT=8789
ASTRO_CHECK_INTERVAL_MS=120000

# Optional VPS-only Telegram alerts. Never expose these to the browser or Sites.
TELEGRAM_BOT_TOKEN=replace-with-a-rotated-bot-token
TELEGRAM_CHAT_ID=-1000000000000
TELEGRAM_MESSAGE_THREAD_ID=replace-with-the-astro-topic-id

# Exact free/paid Astro source chat IDs, comma-separated. Empty means discovery
# only: chat metadata is recorded, but message content is not ingested.
ASTRO_TELEGRAM_SOURCE_CHAT_IDS=-1000000000001,-1000000000002
