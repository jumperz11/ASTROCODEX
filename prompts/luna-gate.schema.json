{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "material": {
      "type": "boolean"
    },
    "severity": {
      "type": "string",
      "enum": ["none", "low", "medium", "high"]
    },
    "category": {
      "type": "string",
      "enum": [
        "no_change",
        "position",
        "take_profit",
        "close",
        "thesis",
        "conflict",
        "market_checkpoint",
        "forecast_resolution"
      ]
    },
    "reason": {
      "type": "string"
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 12
    },
    "needsXSearch": {
      "type": "boolean"
    },
    "mediumReason": {
      "type": "string"
    },
    "brief": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "astroNow": { "type": "string" },
        "changed": { "type": "string" },
        "nextTrigger": { "type": "string" },
        "contradiction": { "type": "string" },
        "levels": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "label": { "type": "string" },
              "value": { "type": "string" },
              "sourceRef": { "type": "string" }
            },
            "required": ["label", "value", "sourceRef"]
          }
        }
      },
      "required": ["astroNow", "changed", "nextTrigger", "contradiction", "levels"]
    },
    "campaign": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "type": "string",
          "enum": ["unknown", "planned", "open", "partial", "closed", "conflict"]
        },
        "direction": {
          "type": "string",
          "enum": ["unknown", "long", "short", "both", "flat"]
        },
        "entry": { "type": "string" },
        "targets": {
          "type": "array",
          "maxItems": 8,
          "items": { "type": "string" }
        },
        "invalidation": { "type": "string" },
        "sourceRefs": {
          "type": "array",
          "maxItems": 12,
          "items": { "type": "string" }
        }
      },
      "required": ["state", "direction", "entry", "targets", "invalidation", "sourceRefs"]
    },
    "lunaBrief": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "facts": {
          "type": "array",
          "maxItems": 8,
          "items": { "type": "string" }
        },
        "question": { "type": "string" },
        "counterCase": { "type": "string" }
      },
      "required": ["facts", "question", "counterCase"]
    }
  },
  "required": [
    "material",
    "severity",
    "category",
    "reason",
    "evidenceRefs",
    "needsXSearch",
    "mediumReason",
    "brief",
    "campaign",
    "lunaBrief"
  ]
}
