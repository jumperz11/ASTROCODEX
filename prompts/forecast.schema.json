{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "market",
    "stance",
    "stanceTone",
    "confidence",
    "headline",
    "summary",
    "nextMove",
    "invalidation",
    "waitFor",
    "decision",
    "signal",
    "execution",
    "thesis",
    "thesisLevels",
    "bias",
    "framework",
    "levels",
    "evidence",
    "scenarios",
    "sources",
    "caveat"
  ],
  "properties": {
    "market": { "type": "string" },
    "stance": { "type": "string" },
    "stanceTone": {
      "type": "string",
      "enum": ["long", "short", "neutral"]
    },
    "confidence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "headline": { "type": "string" },
    "summary": { "type": "string" },
    "nextMove": { "type": "string" },
    "invalidation": { "type": "string" },
    "waitFor": { "type": "string" },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "status", "lookingFor", "playbookMove", "risk"],
      "properties": {
        "position": { "type": "string" },
        "status": { "type": "string" },
        "lookingFor": { "type": "string" },
        "playbookMove": { "type": "string" },
        "risk": { "type": "string" }
      }
    },
    "signal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "plainSummary",
        "astroMayDo",
        "readerStep",
        "changesWhen"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "wait",
            "long",
            "short",
            "take_profit",
            "exit",
            "conflict"
          ]
        },
        "plainSummary": { "type": "string" },
        "astroMayDo": { "type": "string" },
        "readerStep": { "type": "string" },
        "changesWhen": { "type": "string" }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry", "takeProfit", "exit"],
      "properties": {
        "entry": { "$ref": "#/$defs/executionLevel" },
        "takeProfit": { "$ref": "#/$defs/executionLevel" },
        "exit": { "$ref": "#/$defs/executionLevel" }
      }
    },
    "thesis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "horizon",
        "regime",
        "astroConfirmed",
        "modelRead",
        "nextTrigger",
        "failure"
      ],
      "properties": {
        "horizon": { "type": "string" },
        "regime": { "type": "string" },
        "astroConfirmed": { "type": "string" },
        "modelRead": { "type": "string" },
        "nextTrigger": { "type": "string" },
        "failure": { "type": "string" }
      }
    },
    "thesisLevels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "value", "kind", "reason"],
        "properties": {
          "label": { "type": "string" },
          "value": { "type": "string" },
          "kind": {
            "type": "string",
            "enum": ["watch", "upside", "downside"]
          },
          "reason": { "type": "string" }
        }
      }
    },
    "bias": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cyclical", "weekly", "swing"],
      "properties": {
        "cyclical": { "type": "string" },
        "weekly": { "type": "string" },
        "swing": { "type": "string" }
      }
    },
    "framework": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "typeA", "sentiment", "score"],
      "properties": {
        "phase": { "type": "string" },
        "typeA": { "type": "string" },
        "sentiment": { "type": "string" },
        "score": { "type": "string" }
      }
    },
    "levels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "value", "kind"],
        "properties": {
          "label": { "type": "string" },
          "value": { "type": "string" },
          "kind": {
            "type": "string",
            "enum": ["entry", "trim", "risk"]
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "label", "detail", "source", "time"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["astro", "framework", "inference"]
          },
          "label": { "type": "string" },
          "detail": { "type": "string" },
          "source": { "type": "string" },
          "time": { "type": "string" }
        }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "probability", "description", "trigger"],
        "properties": {
          "name": { "type": "string" },
          "probability": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "description": { "type": "string" },
          "trigger": { "type": "string" }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "url"],
        "properties": {
          "label": { "type": "string" },
          "url": { "type": "string" }
        }
      }
    },
    "caveat": { "type": "string" }
  },
  "$defs": {
    "executionLevel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "level", "condition"],
      "properties": {
        "state": { "type": "string" },
        "level": { "type": "string" },
        "condition": { "type": "string" }
      }
    }
  }
}
